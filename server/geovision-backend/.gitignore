# =============================================================================
# ENTERPRISE GRADE .GITIGNORE (geovision-backend)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment & Secrets (STRICT - NEVER COMMIT)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
application-local.yml
application-local.yaml
application-local.properties
application-prod.yml
application-prod.yaml
application-prod.properties
application-secrets.yml
application-secrets.yaml
application-secrets.properties
*.key
*.pem
*.pfx
*.p12
*.jks
jwt-secret.txt
secret.key
secrets/

# -----------------------------------------------------------------------------
# 2. Maven & Build Artifacts
# -----------------------------------------------------------------------------
target/
out/
build/
dist/
bin/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# -----------------------------------------------------------------------------
# 3. Logs & Diagnostic Traces
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*
hs_err_pid*
replay_pid*

# -----------------------------------------------------------------------------
# 4. IDEs & Editors
# -----------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
.idea_modules/

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.apt_generated_tests
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Visual Studio Code & Antigravity IDE
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
.antigravity/

# -----------------------------------------------------------------------------
# 5. Operating System Junk
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*~
.fuse_hidden*
.directory
.Trash-*

