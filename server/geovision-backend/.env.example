# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT PUT SENSITIVE / PRODUCTION CREDENTIALS IN THIS FILE.
# Copy this file to .env and replace placeholder values with your local secrets.
# =============================================================================

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/geovision_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here

# JWT Security Configuration (Requires 256-bit / 32-byte Base64-encoded secret)
JWT_SECRET=your_256_bit_base64_secret_key_here
JWT_EXPIRATION=86400000

# Spring Profiles: local, prod
SPRING_PROFILES_ACTIVE=local
